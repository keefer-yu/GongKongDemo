{
  "device": {
    "id": "reactor-1",
    "name": "1# 反应釜",
    "protocol": "ModbusTcp",
    "host": "127.0.0.1",
    "port": 15020,
    "unitId": 1,
    "scanIntervalMs": 500,
    "reconnect": {
      "initialDelayMs": 1000,
      "maxDelayMs": 10000
    },
    "limits": {
      "pumpMinLevel": 10,
      "heaterMinLevel": 30,
      "heaterMaxTemp": 95,
      "setpointMin": 30,
      "setpointMax": 95
    }
  },
  "tags": [
    {
      "id": "level",
      "name": "液位",
      "address": "HR:0",
      "dataType": "UInt16",
      "byteOrder": "ABCD",
      "scale": 0.1,
      "offset": 0,
      "decimals": 1,
      "unit": "%",
      "writable": false,
      "alarm": { "ll": 5, "l": 15, "h": 85, "hh": 95, "deadband": 2, "delaySeconds": 2 }
    },
    {
      "id": "temp",
      "name": "温度",
      "address": "HR:1",
      "dataType": "Float32",
      "byteOrder": "ABCD",
      "scale": 1,
      "offset": 0,
      "decimals": 1,
      "unit": "°C",
      "writable": false,
      "alarm": { "l": 20, "h": 80, "hh": 95, "deadband": 2, "delaySeconds": 2 }
    },
    {
      "id": "pressure",
      "name": "压力",
      "address": "HR:3",
      "dataType": "UInt16",
      "byteOrder": "ABCD",
      "scale": 0.001,
      "offset": 0,
      "decimals": 3,
      "unit": "MPa",
      "writable": false,
      "alarm": { "h": 0.6, "hh": 0.8, "deadband": 0.03, "delaySeconds": 1 }
    },
    {
      "id": "tempSetpoint",
      "name": "温度设定",
      "address": "HR:4",
      "dataType": "UInt16",
      "byteOrder": "ABCD",
      "scale": 0.1,
      "offset": 0,
      "decimals": 1,
      "unit": "°C",
      "writable": true
    },
    {
      "id": "pump",
      "name": "泵运行",
      "address": "C:0",
      "dataType": "Bool",
      "writable": true
    },
    {
      "id": "heater",
      "name": "加热器",
      "address": "C:1",
      "dataType": "Bool",
      "writable": true
    },
    {
      "id": "valve",
      "name": "出口阀",
      "address": "C:2",
      "dataType": "Bool",
      "writable": true
    },
    {
      "id": "autoMode",
      "name": "自动模式",
      "address": "C:3",
      "dataType": "Bool",
      "writable": true
    }
  ]
}
