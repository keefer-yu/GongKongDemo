<Window x:Class="Scada.Wpf.V1.SeeData.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Scada.UI.Wpf.Controls;assembly=Scada.UI.Wpf"
        Title="V1 看见数据 · SCADA 教学 Demo"
        Width="1280" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="18,10">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="V1 · 看见数据" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="内存模拟设备 → 500ms 轮询 → TagStore → WPF；先理解扫描周期和质量码。"
                               Style="{StaticResource Caption}" Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:StatusLamp IsOn="{Binding IsRunning}" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" Margin="8,0,18,0" Foreground="{StaticResource MutedBrush}" />
                    <Button Content="▶ 启动采集" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="■ 停止" Command="{Binding StopCommand}" />
                    <TextBlock Text="周期 500 ms" Style="{StaticResource Caption}" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72*" />
                <ColumnDefinition Width="28*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="242" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="6"
                                    Margin="5" Padding="12,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="22" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" />
                                        <TextBlock Text="{Binding QualityText}" HorizontalAlignment="Right"
                                                   FontSize="11" Foreground="{Binding Quality, Converter={StaticResource QualityToBrush}}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding ValueText}" FontFamily="{StaticResource NumberFont}"
                                               FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Grid Grid.Row="2">
                                        <TextBlock Text="{Binding Unit}" Style="{StaticResource Caption}" HorizontalAlignment="Left" />
                                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="{Binding MaxValue, Mode=OneWay}"
                                                     VerticalAlignment="Center" Margin="0,0,26,0"
                                                     Visibility="{Binding IsBool, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ui:StatusLamp IsOn="{Binding IsOn}" HorizontalAlignment="Right"
                                                       Width="16" Height="16"
                                                       Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Margin="5" Padding="10">
                    <DataGrid ItemsSource="{Binding Tags}" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="点位" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="90" />
                            <DataGridTextColumn Header="工程值" Binding="{Binding ValueText}" Width="*" />
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" />
                            <DataGridTextColumn Header="质量" Binding="{Binding QualityText}" Width="70" />
                            <DataGridTextColumn Header="原始值" Binding="{Binding RawText}" Width="90" />
                            <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="290" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="采集统计" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Text="设备（内存模拟）→ 每 500 ms 读取 → 采集引擎 → TagStore → WPF"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="采集次数" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding CyclesText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="成功率" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SuccessText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="延迟（最近/平均）" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding LatencyText}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="最近错误" Style="{StaticResource Caption}" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding LastError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Margin="0,8,0,0" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="运行日志" Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" Margin="2,0,0,6" />
                        <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                                 FontFamily="{StaticResource NumberFont}" FontSize="11" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="16,0">
            <TextBlock Text="提示：先启动采集，观察扫描次数与延迟；坏值显示 ERR，不是 0。"
                       Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
