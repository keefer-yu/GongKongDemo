<Window x:Class="Scada.Wpf.V2.Modbus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Scada.UI.Wpf.Controls;assembly=Scada.UI.Wpf"
        Title="V2 连上设备 · Modbus TCP SCADA 教学 Demo"
        Width="1320" Height="860" MinWidth="1120" MinHeight="740"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="238" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="18,8">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="V2 · 连上设备（Modbus TCP）" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="MBAP + PDU → 功能码 01/03/05/06 → 寄存器 → 工程值；右侧可看原始报文。"
                               Style="{StaticResource Caption}" Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:StatusLamp IsOn="{Binding StatusOnline}" IsFault="{Binding StatusFault}"
                                   Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" Margin="8,0,14,0" Foreground="{StaticResource MutedBrush}" />
                    <Button Content="启动模拟 PLC" Command="{Binding StartSimulatorCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="停止模拟（断线）" Command="{Binding StopSimulatorCommand}" />
                    <Button Content="连接并采集" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="断开" Command="{Binding DisconnectCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tags}" Margin="12,8,12,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Margin="5" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="22" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                <TextBlock Text="{Binding QualityText}" HorizontalAlignment="Right"
                                           FontSize="11" Foreground="{Binding Quality, Converter={StaticResource QualityToBrush}}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding ValueText}" FontFamily="{StaticResource NumberFont}"
                                       FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
                            <Grid Grid.Row="2">
                                <TextBlock Text="{Binding Unit}" Style="{StaticResource Caption}" HorizontalAlignment="Left" />
                                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="{Binding MaxValue, Mode=OneWay}"
                                             VerticalAlignment="Center" Margin="0,0,26,0"
                                             Visibility="{Binding IsBool, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ui:StatusLamp IsOn="{Binding IsOn}" HorizontalAlignment="Right" Width="16" Height="16"
                                               Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="16,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="目标" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding TargetText}" Margin="0,0,24,0" />
                <TextBlock Text="采集" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding CyclesText}" Margin="0,0,24,0" />
                <TextBlock Text="成功率" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding SuccessText}" Margin="0,0,24,0" />
                <TextBlock Text="延迟" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding LatencyText}" Margin="0,0,24,0" />
                <TextBlock Text="报文" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding FrameCountText}" Margin="0,0,24,0" />
                <TextBlock Text="错误" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding LastError}" Foreground="{StaticResource DangerBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="43*" />
                <ColumnDefinition Width="57*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64*" />
                    <RowDefinition Height="36*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="点位表（原始值 / 工程值 / 质量）"
                                   Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="2,0,0,6" />
                        <DataGrid ItemsSource="{Binding Tags}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="点位" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80" />
                                <DataGridTextColumn Header="工程值" Binding="{Binding ValueText}" Width="*" />
                                <DataGridTextColumn Header="原始值" Binding="{Binding RawText}" Width="90" />
                                <DataGridTextColumn Header="质量" Binding="{Binding QualityText}" Width="70" />
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="105" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Margin="0,8,0,0" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="运行日志" Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" Margin="2,0,0,6" />
                        <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                                 FontFamily="{StaticResource NumberFont}" FontSize="11" />
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Modbus 报文（TID / FC / 地址 / 数量 / 十六进制）"
                               Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="2,0,0,6" />
                    <DataGrid ItemsSource="{Binding Frames}" FontFamily="{StaticResource NumberFont}" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="92" />
                            <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="50" />
                            <DataGridTextColumn Header="十六进制" Binding="{Binding Hex}" Width="*" />
                            <DataGridTextColumn Header="解码" Binding="{Binding Summary}" Width="250" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
